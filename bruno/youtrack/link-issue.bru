meta {
  name: Link Issue (Parent for)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/api/commands
  body: json
  auth: none
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
  Accept: application/json
}

body:json {
  {
    "query": "parent for {{childIssueReadableId}}",
    "issues": [{ "id": "{{parentIssueInternalId}}" }]
  }
}
